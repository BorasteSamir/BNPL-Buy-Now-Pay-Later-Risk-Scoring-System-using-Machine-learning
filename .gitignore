# ─────────────────────────────────────────────
# DATA FILES (large / sensitive)
# ─────────────────────────────────────────────
data/Loan_data.csv
data/clean_data.csv
data/featured_data.csv
data/*.csv
data/*.parquet
data/*.json
data/*.xlsx
data/*.zip

# Keep the data folder itself
!data/.gitkeep

# ─────────────────────────────────────────────
# TRAINED MODEL ARTIFACTS
# ─────────────────────────────────────────────
models/*.pkl
models/*.joblib
models/*.h5
models/*.pt
models/*.bin

# Keep the models folder itself
!models/.gitkeep

# ─────────────────────────────────────────────
# REPORTS / GENERATED PLOTS
# ─────────────────────────────────────────────
reports/*.png
reports/*.jpg
reports/*.pdf
reports/*.json

# Keep the reports folder itself
!reports/.gitkeep

